# 溯真 - 环境变量配置示例
# 复制本文件为 .env 后填入真实密钥（.env 已加入 .gitignore，不会提交）
#
# 只想体验 UI？  启动后侧边栏切到「演示模式（零网络）」，下面全部留空即可。

# ===== 大模型配置 =====
# 兼容 OpenAI API 格式的密钥（真实 LLM 拆解 / 完整真实核查 模式必填）
LLM_API_KEY=

# 兼容接口地址（可选，留空则使用 SDK 默认 https://api.openai.com/v1）
# 常用示例：
#   DeepSeek:   https://api.deepseek.com/v1
#   通义千问:   https://dashscope.aliyuncs.com/compatible-mode/v1
#   Moonshot:   https://api.moonshot.cn/v1
#   Ollama:     http://localhost:11434/v1
#   LM Studio:  http://localhost:1234/v1
#   vLLM:       http://localhost:8000/v1
LLM_BASE_URL=

# 模型名称（真实 LLM 拆解 / 完整真实核查 模式必填）
# 常用示例：
#   deepseek-chat  gpt-4o-mini  gpt-4o  qwen-plus  qwen-long
#   moonshot-v1-8k  glm-4-flash  yi-lightning
LLM_MODEL=

# 单次 LLM 请求超时秒数（可选，默认 60）
LLM_TIMEOUT=60

# ===== Tavily 搜索配置 =====
# 申请地址：https://tavily.com/ — 注册后在 Dashboard 可获取 API Key
# 完整真实核查模式必填；演示模式 / 真实 LLM 拆解 模式不需要
TAVILY_API_KEY=

# 单次 Tavily 搜索超时秒数（可选，默认 25；国内网络建议 ≥ 20）
TAVILY_TIMEOUT=25

# 每条主张最多生成的搜索语句数（默认 2，避免消耗过多额度）
SEARCH_MAX_QUERIES_PER_CLAIM=2

# 每条搜索语句最多返回的网页结果数（默认 5）
SEARCH_MAX_RESULTS_PER_QUERY=5

# 单份报告最多处理的网页结果总数（默认 20，避免失控消耗 API 额度）
SEARCH_MAX_TOTAL_RESULTS=20

# ===== 记忆库配置（可选）=====
# SQLite 记忆库存储路径（默认 data/memory.db）
# MEMORY_DB_PATH=data/memory.db
